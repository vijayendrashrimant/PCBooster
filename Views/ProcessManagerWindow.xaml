<Window x:Class="PCBooster.Views.ProcessManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Manager — PC Booster Pro"
        Height="640" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        ResizeMode="CanResize"
        MinWidth="700" MinHeight="400">

    <Window.Resources>
        <!-- ListView column header style -->
        <Style x:Key="ColHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background"          Value="#0D1117"/>
            <Setter Property="Foreground"          Value="#9FA8C0"/>
            <Setter Property="BorderThickness"     Value="0,0,0,1"/>
            <Setter Property="BorderBrush"         Value="#2D3561"/>
            <Setter Property="Padding"             Value="8,6"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="FontWeight"          Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"              Value="Hand"/>
        </Style>

        <!-- Row style -->
        <Style x:Key="ProcRow" TargetType="ListViewItem">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#E8EAF6"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="4,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#1A2A40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E2A4A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1A3560"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#4FA3E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kill button style -->
        <Style x:Key="KillBtn" TargetType="Button">
            <Setter Property="Background"      Value="#3A1010"/>
            <Setter Property="Foreground"      Value="#FF5F57"/>
            <Setter Property="BorderBrush"     Value="#7A1515"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,2"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#5A1515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="#0D1117" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Process Manager" Foreground="#E8EAF6" FontSize="15" FontWeight="Medium"/>
                        <TextBlock x:Name="ProcCountLabel" Text="Loading…"
                                   Foreground="#9FA8C0" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search box -->
                <Border Grid.Column="1" Background="#16213E" BorderBrush="#2D3561"
                        BorderThickness="1" CornerRadius="6"
                        Margin="20,0" VerticalAlignment="Center" Padding="10,6">
                    <Grid>
                        <TextBlock Text="🔍  Search processes…" Foreground="#4A5568" FontSize="12"
                                   x:Name="SearchHint" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" Foreground="#E8EAF6"
                                 BorderThickness="0" FontSize="12"
                                 TextChanged="SearchBox_TextChanged"
                                 GotFocus="SearchBox_GotFocus"
                                 LostFocus="SearchBox_LostFocus"
                                 CaretBrush="#4FA3E0"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="SortCombo" Background="#16213E" Foreground="#9FA8C0"
                              BorderBrush="#2D3561" FontSize="12" Margin="0,0,8,0"
                              SelectionChanged="SortCombo_Changed">
                        <ComboBoxItem Content="Sort: RAM" IsSelected="True"/>
                        <ComboBoxItem Content="Sort: CPU"/>
                        <ComboBoxItem Content="Sort: Name"/>
                    </ComboBox>
                    <Button Content="↻ Refresh" Click="Refresh_Click"
                            Background="#1E2A4A" Foreground="#9FA8C0"
                            BorderBrush="#2D3561" BorderThickness="1"
                            Padding="10,5" FontSize="12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#1A3560"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary tiles -->
        <Grid Grid.Row="1" Background="#0F1620" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#2D3561" BorderThickness="0,0,1,1" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="PROCESSES" Foreground="#4A5568" FontSize="10"/>
                    <TextBlock x:Name="TotalProcs" Text="—" Foreground="#E8EAF6" FontSize="18" FontWeight="Medium"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" BorderBrush="#2D3561" BorderThickness="0,0,1,1" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="NOT RESPONDING" Foreground="#4A5568" FontSize="10"/>
                    <TextBlock x:Name="NotRespondingCount" Text="—" Foreground="#FF5F57" FontSize="18" FontWeight="Medium"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="#2D3561" BorderThickness="0,0,1,1" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="TOTAL RAM USED" Foreground="#4A5568" FontSize="10"/>
                    <TextBlock x:Name="TotalRam" Text="—" Foreground="#FEBC2E" FontSize="18" FontWeight="Medium"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" BorderBrush="#2D3561" BorderThickness="0,0,0,1" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="AUTO-REFRESH" Foreground="#4A5568" FontSize="10"/>
                    <ToggleButton x:Name="AutoRefreshToggle" Content="ON"
                                  IsChecked="True" Checked="AutoRefresh_Toggle"
                                  Unchecked="AutoRefresh_Toggle"
                                  Background="Transparent" Foreground="#28C840"
                                  BorderThickness="0" FontSize="14" FontWeight="Medium"
                                  HorizontalAlignment="Left" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Process List -->
        <ListView x:Name="ProcessList" Grid.Row="2"
                  Background="#1A1A2E" Foreground="#E8EAF6"
                  BorderThickness="0"
                  ItemContainerStyle="{StaticResource ProcRow}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionMode="Single">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource ColHeader}">
                    <GridViewColumn Header="Process Name" Width="200"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="PID" Width="65"
                                    DisplayMemberBinding="{Binding Pid}"/>
                    <GridViewColumn Header="RAM (MB)" Width="90"
                                    DisplayMemberBinding="{Binding RamMB}"/>
                    <GridViewColumn Header="CPU %" Width="80"
                                    DisplayMemberBinding="{Binding CpuPercent}"/>
                    <GridViewColumn Header="Status" Width="110"
                                    DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="Started" Width="70"
                                    DisplayMemberBinding="{Binding StartTimeDisplay}"/>
                    <GridViewColumn Header="Impact" Width="70"
                                    DisplayMemberBinding="{Binding Impact}"/>
                    <GridViewColumn Header="" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Kill" Style="{StaticResource KillBtn}"
                                        Tag="{Binding Pid}"
                                        Click="KillProcess_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#0D1117" Padding="16,8" BorderBrush="#2D3561" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ProcStatusText"
                           Text="Ready" Foreground="#4A5568" FontSize="11"/>
                <TextBlock x:Name="LastRefreshText"
                           HorizontalAlignment="Right" Foreground="#4A5568" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
