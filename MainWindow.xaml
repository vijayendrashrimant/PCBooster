<Window x:Class="PCBooster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCBooster"
        xmlns:converters="clr-namespace:PCBooster.Converters"
        Title="PC Booster Pro" Height="620" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <converters:PercentToColorConverter x:Key="PercentToColor"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:ActionDoneConverter x:Key="ActionDoneConverter"/>

        <!-- Base Colors -->
        <SolidColorBrush x:Key="BgDark"     Color="#1A1A2E"/>
        <SolidColorBrush x:Key="BgMid"      Color="#16213E"/>
        <SolidColorBrush x:Key="BgCard"     Color="#0F3460"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4FA3E0"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#28C840"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FEBC2E"/>
        <SolidColorBrush x:Key="AccentRed"  Color="#FF5F57"/>
        <SolidColorBrush x:Key="TextPrim"   Color="#E8EAF6"/>
        <SolidColorBrush x:Key="TextSec"    Color="#9FA8C0"/>
        <SolidColorBrush x:Key="Border"     Color="#2D3561"/>

        <!-- Sidebar NavItem Style -->
        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9FA8C0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" BorderThickness="0,0,3,0" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E2A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active NavItem Style -->
        <Style x:Key="NavItemActiveStyle" TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
            <Setter Property="Foreground" Value="#4FA3E0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#1A2E50" BorderThickness="0,0,3,0" BorderBrush="#4FA3E0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="BoostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A6FAD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#155A8F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#1B6E3B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Action Button -->
        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2A4A"/>
            <Setter Property="Foreground" Value="#9FA8C0"/>
            <Setter Property="BorderBrush" Value="#2D3561"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1A3560"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#4FA3E0"/>
                                <Setter Property="Foreground" Value="#4FA3E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#0D2B1A"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#1B6E3B"/>
                                <Setter Property="Foreground" Value="#28C840"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar Style -->
        <Style x:Key="MetricBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#2D3561"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left"
                                        CornerRadius="3"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#0D1117" MouseDown="TitleBar_MouseDown">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <Border Width="20" Height="20" Background="#1A6FAD" CornerRadius="4" Margin="0,0,8,0">
                        <TextBlock Text="⚡" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PC Booster Pro" Foreground="#E8EAF6" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button Content="⎯" Width="32" Height="28" Background="Transparent" Foreground="#9FA8C0"
                            BorderThickness="0" FontSize="12" Cursor="Hand" Click="MinimizeWindow"/>
                    <Button Content="✕" Width="32" Height="28" Background="Transparent" Foreground="#9FA8C0"
                            BorderThickness="0" FontSize="12" Cursor="Hand" Click="CloseWindow"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#0D1117" BorderBrush="#2D3561" BorderThickness="0,0,1,0">
                <StackPanel>
                    <TextBlock Text="OVERVIEW" Foreground="#4A5568" FontSize="10" FontWeight="Medium"
                               Margin="16,16,0,6" />

                    <Button Style="{StaticResource NavItemActiveStyle}" Height="38" Click="Nav_Dashboard">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⊞" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="Dashboard" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemStyle}" Height="38" Click="Nav_Performance">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="Performance" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="TOOLS" Foreground="#4A5568" FontSize="10" FontWeight="Medium"
                               Margin="16,12,0,6" />

                    <Button Style="{StaticResource NavItemStyle}" Height="38" Click="Nav_JunkCleaner">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🗑" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="Junk Cleaner" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemStyle}" Height="38" Click="Nav_Startup">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="Startup Manager" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemStyle}" Height="38" Click="Nav_Ram">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💾" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="RAM Optimizer" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemStyle}" Height="38">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="Driver Updates" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}" Height="38" Click="Nav_Network">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="Network Monitor" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemStyle}" Height="38" Click="Nav_Battery">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔋" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="Battery" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemStyle}" Height="38" Click="Nav_Processes">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="Process Manager" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="SYSTEM" Foreground="#4A5568" FontSize="10" FontWeight="Medium"
                               Margin="16,12,0,6" />

                    <Button Style="{StaticResource NavItemStyle}" Height="38">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛡" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="Security" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItemStyle}" Height="38">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="Settings" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- Version info at bottom -->
                    <TextBlock Text="v2.4.1 — Up to date" Foreground="#4A5568" FontSize="11"
                               Margin="16,32,0,0"/>
                </StackPanel>
            </Border>

            <!-- Dashboard Content -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#1A1A2E">
                <StackPanel Margin="20">

                    <!-- Score + Boost Section -->
                    <Border Background="#16213E" BorderBrush="#2D3561" BorderThickness="1"
                            CornerRadius="12" Padding="20" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Score Ring (Canvas drawn in code-behind) -->
                            <Canvas x:Name="ScoreCanvas" Width="100" Height="100" Margin="0,0,20,0">
                                <!-- Ring drawn programmatically -->
                            </Canvas>

                            <!-- Score Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="PC Health Score" Foreground="#E8EAF6"
                                           FontSize="16" FontWeight="Medium" Margin="0,0,0,4"/>
                                <TextBlock x:Name="ScoreDescription" Foreground="#9FA8C0"
                                           FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="3 issues found affecting performance. Click Boost to fix them automatically."/>
                                <Button x:Name="BoostButton" Style="{StaticResource BoostButtonStyle}"
                                        HorizontalAlignment="Left" Click="BoostButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ " FontSize="13"/>
                                        <TextBlock x:Name="BoostButtonText" Text="Boost Now" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Metric Tiles -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU -->
                        <Border Grid.Column="0" Background="#16213E" BorderBrush="#2D3561"
                                BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="🖥  CPU" Foreground="#9FA8C0" FontSize="12" Margin="0,0,0,8"/>
                                <ProgressBar x:Name="CpuBar" Style="{StaticResource MetricBar}"
                                             Foreground="#FEBC2E" Value="62" Maximum="100" Margin="0,0,0,6"/>
                                <Grid>
                                    <TextBlock x:Name="CpuValue" Text="62%" Foreground="#E8EAF6" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="i7-12700" Foreground="#4A5568" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- RAM -->
                        <Border Grid.Column="2" Background="#16213E" BorderBrush="#2D3561"
                                BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="💾  RAM" Foreground="#9FA8C0" FontSize="12" Margin="0,0,0,8"/>
                                <ProgressBar x:Name="RamBar" Style="{StaticResource MetricBar}"
                                             Foreground="#FF5F57" Value="78" Maximum="100" Margin="0,0,0,6"/>
                                <Grid>
                                    <TextBlock x:Name="RamValue" Text="78%" Foreground="#E8EAF6" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="16 GB DDR4" Foreground="#4A5568" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Disk -->
                        <Border Grid.Column="4" Background="#16213E" BorderBrush="#2D3561"
                                BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="💿  Disk" Foreground="#9FA8C0" FontSize="12" Margin="0,0,0,8"/>
                                <ProgressBar x:Name="DiskBar" Style="{StaticResource MetricBar}"
                                             Foreground="#28C840" Value="44" Maximum="100" Margin="0,0,0,6"/>
                                <Grid>
                                    <TextBlock x:Name="DiskValue" Text="44%" Foreground="#E8EAF6" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="500 GB SSD" Foreground="#4A5568" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Temp -->
                        <Border Grid.Column="6" Background="#16213E" BorderBrush="#2D3561"
                                BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="🌡  Temp" Foreground="#9FA8C0" FontSize="12" Margin="0,0,0,8"/>
                                <ProgressBar x:Name="TempBar" Style="{StaticResource MetricBar}"
                                             Foreground="#FEBC2E" Value="55" Maximum="100" Margin="0,0,0,6"/>
                                <Grid>
                                    <TextBlock x:Name="TempValue" Text="55°C" Foreground="#E8EAF6" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="Normal" Foreground="#4A5568" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Recommended Actions -->
                    <TextBlock Text="Recommended Actions" Foreground="#E8EAF6"
                               FontSize="14" FontWeight="Medium" Margin="0,0,0,10"/>

                    <!-- Action 1: Junk Files -->
                    <Border Background="#16213E" BorderBrush="#2D3561" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Background="#2D1F0A" CornerRadius="8" Margin="0,0,12,0">
                                <TextBlock Text="🗑" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Clear junk files" Foreground="#E8EAF6" FontSize="13" FontWeight="Medium"/>
                                <TextBlock Text="3.2 GB of temp files, logs, and cache found" Foreground="#9FA8C0" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="CleanBtn" Content="Clean"
                                    Style="{StaticResource SmallActionButton}"
                                    Click="CleanJunk_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Action 2: Startup -->
                    <Border Background="#16213E" BorderBrush="#2D3561" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Background="#1A0A0A" CornerRadius="8" Margin="0,0,12,0">
                                <TextBlock Text="⚡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Disable startup apps" Foreground="#E8EAF6" FontSize="13" FontWeight="Medium"/>
                                <TextBlock Text="7 apps are slowing your boot time by ~18 seconds" Foreground="#9FA8C0" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="StartupBtn" Content="Fix"
                                    Style="{StaticResource SmallActionButton}"
                                    Click="FixStartup_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Action 3: RAM -->
                    <Border Background="#16213E" BorderBrush="#2D3561" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Background="#0A1A2E" CornerRadius="8" Margin="0,0,12,0">
                                <TextBlock Text="💾" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Free unused RAM" Foreground="#E8EAF6" FontSize="13" FontWeight="Medium"/>
                                <TextBlock Text="1.8 GB can be reclaimed from idle background processes" Foreground="#9FA8C0" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="RamBtn" Content="Optimize"
                                    Style="{StaticResource SmallActionButton}"
                                    Click="OptimizeRam_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Status Bar -->
                    <Border BorderBrush="#2D3561" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" Fill="#28C840" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.2" Duration="0:0:1" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock x:Name="StatusText" Grid.Column="1"
                                       Text="System monitoring active — last scan: just now"
                                       Foreground="#4A5568" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LastScanText" Grid.Column="2"
                                       Foreground="#4A5568" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
